{% extends "base.html.j2" %}
{% block title %}Hóa đơn #{{ invoice.id }} - {{ invoice.room.name }} - RentCalc{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
    <!-- Nút quay lại và tiêu đề -->
    <div class="flex justify-between items-center border-b pb-4 border-gray-200">
        <div>
            <a href="/rooms/{{ invoice.room_id }}" class="inline-flex items-center px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-50 shadow-sm transition mb-2">
                &larr; Quay lại phòng {{ invoice.room.name }}
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Hóa Đơn Dịch Vụ Thiết Yếu — Kỳ {{ invoice.month }}</h1>
            <p class="text-xs text-gray-500 mt-1">Phòng: <strong>{{ invoice.room.name }}</strong> | Số người ở: <strong>{{ snap.people_count }}</strong> | Trạng thái: <strong>{% if snap.is_declared %}Đã kê khai tạm trú{% else %}Không kê khai (Áp Bậc 3){% endif %}</strong></p>
        </div>
        <div class="text-right">
            <span class="px-3 py-1 bg-indigo-100 text-indigo-800 font-mono text-xs rounded-full font-bold">Snapshot Cố Định</span>
        </div>
    </div>

    <!-- KHỐI 1: BÓC TÁCH TIỀN ĐIỆN THEO BẬC THANG LŨY TIẾN -->
    <div class="bg-white shadow rounded-lg border border-gray-200 overflow-hidden">
        <div class="bg-amber-500 px-6 py-3 text-white flex justify-between items-center">
            <h2 class="font-bold flex items-center space-x-2">
                <span>⚡</span>
                <span>TIỀN ĐIỆN SINH HOẠT THEO QUY ĐỊNH (QĐ 1279 & TT 60/2025/TT-BCT)</span>
            </h2>
            <span class="text-xs bg-amber-600 px-2 py-1 rounded font-mono">
                Sản lượng: {{ calc.electricity.consumption }} kWh
            </span>
        </div>

        <div class="p-6">
            <div class="text-xs text-gray-500 mb-4 flex space-x-4">
                <span>Phương thức: <strong>{% if calc.electricity.method == 'tiered' %}Bậc thang có định mức{% else %}Áp Bậc 3 cố định{% endif %}</strong></span>
                {% if calc.electricity.quota %}
                <span>•</span>
                <span>Số định mức hộ: <strong>{{ calc.electricity.quota }} định mức</strong> ({{ snap.people_count }} người / 4)</span>
                {% endif %}
            </div>

            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="px-4 py-2 text-left font-medium">Bậc thang</th>
                        <th class="px-4 py-2 text-right font-medium">Sản lượng (kWh)</th>
                        <th class="px-4 py-2 text-right font-medium">Đơn giá (đ/kWh)</th>
                        <th class="px-4 py-2 text-right font-bold">Thành tiền (đ)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for line in calc.electricity.breakdown %}
                    <tr>
                        <td class="px-4 py-2 font-medium text-gray-800">{{ line.tier_name }}</td>
                        <td class="px-4 py-2 text-right font-mono">{{ line.consumption }}</td>
                        <td class="px-4 py-2 text-right font-mono">{{ line.unit_price|vnd }}</td>
                        <td class="px-4 py-2 text-right font-mono font-semibold">{{ line.amount|vnd }}</td>
                    </tr>
                    {% endfor %}
                    <tr class="bg-gray-50 font-medium">
                        <td colspan="3" class="px-4 py-2 text-right text-gray-700">Cộng tiền điện trước thuế:</td>
                        <td class="px-4 py-2 text-right font-mono">{{ calc.electricity.subtotal|vnd }} đ</td>
                    </tr>
                    <tr class="bg-gray-50 text-xs text-gray-600">
                        <td colspan="3" class="px-4 py-1 text-right">Thuế GTGT (VAT {{ calc.electricity.vat_rate|pct }}):</td>
                        <td class="px-4 py-1 text-right font-mono">{{ calc.electricity.vat|vnd }} đ</td>
                    </tr>
                    <tr class="bg-amber-50 font-bold text-amber-900 border-t-2 border-amber-300">
                        <td colspan="3" class="px-4 py-2 text-right">TỔNG TIỀN ĐIỆN ĐÃ LÀM TRÒN:</td>
                        <td class="px-4 py-2 text-right font-mono text-base">{{ calc.electricity.total_rounded|vnd }} đ</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- KHỐI 2: TIỀN NƯỚC SINH HOẠT -->
    <div class="bg-white shadow rounded-lg border border-gray-200 overflow-hidden">
        <div class="bg-blue-600 px-6 py-3 text-white flex justify-between items-center">
            <h2 class="font-bold flex items-center space-x-2">
                <span>💧</span>
                <span>TIỀN NƯỚC SINH HOẠT (KÈM VAT 5% & PHÍ BVMT 10%)</span>
            </h2>
            <span class="text-xs bg-blue-700 px-2 py-1 rounded font-mono">
                {% if calc.water.mode == 'volume' %}{{ calc.water.quantity }} m³{% else %}{{ calc.water.quantity }} người{% endif %}
            </span>
        </div>

        <div class="p-6">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <tbody class="divide-y divide-gray-100">
                    <tr>
                        <td class="py-2 text-gray-600">Phương thức tính:</td>
                        <td class="py-2 text-right font-semibold">{% if calc.water.mode == 'volume' %}Đồng hồ nước theo khối{% else %}Khoán theo đầu người{% endif %}</td>
                    </tr>
                    <tr>
                        <td class="py-2 text-gray-600">Khối lượng / Nhân khẩu:</td>
                        <td class="py-2 text-right font-mono">{% if calc.water.mode == 'volume' %}{{ calc.water.quantity }} m³{% else %}{{ calc.water.quantity }} người{% endif %}</td>
                    </tr>
                    <tr>
                        <td class="py-2 text-gray-600">Đơn giá nước sạch:</td>
                        <td class="py-2 text-right font-mono">{{ calc.water.unit_price|vnd }} đ/{% if calc.water.mode == 'volume' %}m³{% else %}người{% endif %}</td>
                    </tr>
                    <tr class="bg-gray-50">
                        <td class="py-2 text-gray-700 font-medium">Tiền nước trước thuế:</td>
                        <td class="py-2 text-right font-mono font-medium">{{ calc.water.water_before_tax|vnd }} đ</td>
                    </tr>
                    <tr class="text-xs text-gray-500">
                        <td class="py-1">Thuế GTGT (VAT 5%):</td>
                        <td class="py-1 text-right font-mono">{{ calc.water.vat|vnd }} đ</td>
                    </tr>
                    <tr class="text-xs text-gray-500">
                        <td class="py-1">Phí Bảo vệ môi trường nước thải (10%):</td>
                        <td class="py-1 text-right font-mono">{{ calc.water.env_fee|vnd }} đ</td>
                    </tr>
                    <tr class="bg-blue-50 font-bold text-blue-900 border-t-2 border-blue-300">
                        <td class="py-2">TỔNG TIỀN NƯỚC ĐÃ LÀM TRÒN:</td>
                        <td class="py-2 text-right font-mono text-base">{{ calc.water.total_rounded|vnd }} đ</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- KHỐI 3: TỔNG THANH TOÁN QUY ĐỊNH -->
    <div class="bg-indigo-900 text-white rounded-lg p-6 shadow-md flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold">TỔNG CỘNG HÓA ĐƠN THEO QUY ĐỊNH PHÁP LUẬT</h3>
            <p class="text-xs text-indigo-300 mt-1">Bao gồm toàn bộ tiền điện bậc thang và tiền nước đã cộng đủ thuế phí.</p>
        </div>
        <div class="text-3xl font-black font-mono text-amber-300">
            {{ invoice.invoice_total_final|vnd }} đ
        </div>
    </div>

    <!-- KHỐI 4: ĐỐI CHIẾU THỰC THU & CẢNH BÁO NGHỊ ĐỊNH 133/2026/NĐ-CP -->
    <div class="bg-white shadow rounded-lg border border-gray-200 p-6 space-y-4">
        <h3 class="text-base font-bold text-gray-900 flex items-center space-x-2">
            <span>⚖️</span>
            <span>ĐỐI CHIẾU TIỀN THỰC TẾ CHỦ NHÀ THU</span>
        </h3>

        <!-- Form nhập tiền thực thu -->
        <form action="/invoices/{{ invoice.id }}/comparison" method="POST" class="flex items-end gap-3 bg-gray-50 p-4 rounded-md border border-gray-200">
            <div class="flex-grow">
                <label class="block text-xs font-semibold text-gray-700">Số tiền chủ nhà thực tế thông báo thu (VNĐ):</label>
                <input type="text" name="actual_collected" required value="{{ invoice.actual_collected or '' }}" placeholder="Ví dụ: 850000" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono font-bold">
            </div>
            <button type="submit" class="px-5 py-2 bg-indigo-600 text-white text-sm font-semibold rounded hover:bg-indigo-700 transition">
                Đối chiếu chênh lệch
            </button>
        </form>

        <!-- Kết quả đối chiếu pháp lý -->
        {% if invoice.actual_collected is not none %}
        <div class="mt-4 p-5 rounded-lg border {% if invoice.difference > 0 %}bg-red-50 border-red-300 text-red-900{% else %}bg-green-50 border-green-300 text-green-900{% endif %}">
            <div class="flex justify-between items-center text-sm mb-2">
                <span>Số tiền chủ nhà thu: <strong class="font-mono">{{ invoice.actual_collected|vnd }} đ</strong></span>
                <span>Tiền theo quy định: <strong class="font-mono">{{ invoice.invoice_total_final|vnd }} đ</strong></span>
                <span>Chênh lệch: <strong class="font-mono text-base {% if invoice.difference > 0 %}text-red-700{% else %}text-green-700{% endif %}">{% if invoice.difference > 0 %}+{% endif %}{{ invoice.difference|vnd }} đ</strong></span>
            </div>

            {% if invoice.difference > 0 %}
            <div class="mt-3 pt-3 border-t border-red-200 text-xs space-y-1">
                <p class="font-bold text-red-800">⚠️ CẢNH BÁO VI PHẠM QUY ĐỊNH PHÁP LUẬT:</p>
                <p>Chủ nhà trọ đang thu cao hơn quy chuẩn nhà nước <strong>{{ invoice.difference|vnd }} đ</strong>.</p>
                <p class="text-red-700">Căn cứ <strong>Điều 31 Nghị định số 133/2026/NĐ-CP</strong>, hành vi thu tiền điện nước của người thuê nhà trọ cao hơn giá quy định có thể bị xử phạt hành chính từ <strong>20.000.000 đ đến 30.000.000 đ</strong> và buộc hoàn trả toàn bộ số tiền thu chênh lệch bất hợp pháp cho người thuê!</p>
            </div>
            {% else %}
            <div class="mt-2 text-xs text-green-800">
                ✓ <strong>HỢP LỆ:</strong> Chủ nhà trọ thu đúng hoặc thấp hơn mức quy định nhà nước. Hóa đơn minh bạch, tuân thủ pháp luật.
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <!-- KHỐI 5: LINK CHIA SẺ HÓA ĐƠN CÔNG KHAI -->
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-gray-600">
        <div class="flex items-center space-x-2">
            <span class="font-bold text-gray-800 whitespace-nowrap">🔗 Link tra cứu công khai:</span>
            <a href="/share/{{ share_token }}" target="_blank" class="font-mono text-indigo-600 hover:text-indigo-800 hover:underline break-all bg-white px-2 py-1 rounded border border-gray-200">
                /share/{{ share_token }}
            </a>
        </div>
        <button onclick="const url = window.location.origin + '/share/{{ share_token }}'; navigator.clipboard.writeText(url); alert('Đã sao chép liên kết tra cứu công khai: ' + url);" class="inline-flex items-center justify-center px-3 py-1.5 bg-white border border-gray-300 rounded-md font-medium hover:bg-gray-100 text-gray-700 shadow-sm transition whitespace-nowrap">
            📋 Sao chép link công khai
        </button>
    </div>
</div>
{% endblock %}