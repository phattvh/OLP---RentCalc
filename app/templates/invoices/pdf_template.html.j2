<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Hóa đơn tiền phòng {{ invoice.room.name }} - Kỳ {{ invoice.month }}</title>
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
        }
        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
            line-height: 1.4;
            font-size: 12px;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #2b6cb0;
            padding-bottom: 10px;
            margin-bottom: 15px;
        }
        .title {
            font-size: 18px;
            font-weight: bold;
            color: #2b6cb0;
            margin: 5px 0;
            text-transform: uppercase;
        }
        .meta-table {
            width: 100%;
            margin-bottom: 15px;
        }
        .meta-table td {
            padding: 4px;
        }
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        table.data-table th, table.data-table td {
            border: 1px solid #cbd5e0;
            padding: 6px 8px;
        }
        table.data-table th {
            background-color: #edf2f7;
            font-weight: bold;
            text-align: center;
        }
        .text-right { text-align: right; }
        .text-center { text-align: center; }
        .font-bold { font-weight: bold; }
        .section-heading {
            font-size: 13px;
            font-weight: bold;
            color: #2d3748;
            background-color: #f7fafc;
            padding: 5px 8px;
            border-left: 4px solid #3182ce;
            margin: 15px 0 8px 0;
        }
        .total-box {
            background-color: #ebf8ff;
            border: 2px solid #3182ce;
            padding: 10px 15px;
            font-size: 15px;
            font-weight: bold;
            color: #2b6cb0;
            text-align: right;
            margin-top: 15px;
        }
        .signature-table {
            width: 100%;
            margin-top: 30px;
            text-align: center;
        }
        .signature-space {
            height: 60px;
        }
    </style>
</head>
<body>
    <div class="header">
        <div style="font-size: 14px; font-weight: bold; color: #4a5568;">HỆ THỐNG QUẢN LÝ NHÀ TRỌ MINH BẠCH - RENTCALC</div>
        <div class="title">GIẤY BÁO TIỀN PHÒNG & ĐIỆN NƯỚC SINH HOẠT</div>
        <div style="font-style: italic; color: #718096;">Kỳ thanh toán: Tháng {{ invoice.month }}</div>
    </div>

    <table class="meta-table">
        <tr>
            <td width="50%"><strong>Cơ sở cho thuê:</strong> {{ invoice.room.property.name }}</td>
            <td width="50%"><strong>Phòng:</strong> {{ invoice.room.name }}</td>
        </tr>
        <tr>
            <td><strong>Địa chỉ:</strong> {{ invoice.room.property.address or 'Theo hợp đồng thuê' }}</td>
            <td><strong>Số nhân khẩu đăng ký:</strong> {{ snap.people_count }} người</td>
        </tr>
        <tr>
            <td><strong>Số định mức điện áp dụng:</strong> {{ calc.electricity.quota or 1 }} định mức</td>
            <td><strong>Mã hóa đơn:</strong> #{{ invoice.id }}</td>
        </tr>
    </table>

    <!-- PHẦN 1: TIỀN ĐIỆN -->
    <div class="section-heading">1. BÓC TÁCH TIỀN ĐIỆN THEO BẬC THANG (QĐ 2741/QĐ-BCT)</div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Bậc thang</th>
                <th>Sản lượng (kWh)</th>
                <th>Đơn giá quy định (đ)</th>
                <th>Thành tiền (đ)</th>
            </tr>
        </thead>
        <tbody>
            {% for line in calc.electricity.breakdown %}
            <tr>
                <td>{{ line.tier_name }}</td>
                <td class="text-right">{{ line.consumption }}</td>
                <td class="text-right">{{ line.unit_price|vnd }}</td>
                <td class="text-right font-bold">{{ line.amount|vnd }}</td>
            </tr>
            {% endfor %}
            <tr>
                <td colspan="3" class="text-right"><strong>Tiền điện trước thuế:</strong></td>
                <td class="text-right font-bold">{{ calc.electricity.subtotal|vnd }} đ</td>
            </tr>
            <tr>
                <td colspan="3" class="text-right">Thuế GTGT (VAT {{ calc.electricity.vat_rate|pct }}):</td>
                <td class="text-right">{{ calc.electricity.vat|vnd }} đ</td>
            </tr>
            <tr style="background-color: #feebc8;">
                <td colspan="3" class="text-right"><strong>TỔNG TIỀN ĐIỆN (ĐÃ LÀM TRÒN):</strong></td>
                <td class="text-right font-bold" style="color: #9c4221;">{{ calc.electricity.total_rounded|vnd }} đ</td>
            </tr>
        </tbody>
    </table>

    <!-- PHẦN 2: TIỀN NƯỚC -->
    <div class="section-heading">2. TIỀN NƯỚC SINH HOẠT & PHÍ MÔI TRƯỜNG</div>
    <table class="data-table">
        <thead>
            <tr>
                <th>Phương thức tính</th>
                <th>Khối lượng / Nhân khẩu</th>
                <th>Đơn giá (đ)</th>
                <th>Tiền trước thuế (đ)</th>
                <th>VAT 5% + BVMT 10%</th>
                <th>Tổng tiền nước (đ)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{% if calc.water.mode == 'volume' %}Đồng hồ khối{% else %}Khoán đầu người{% endif %}</td>
                <td class="text-center">{% if calc.water.mode == 'volume' %}{{ calc.water.quantity }} m³{% else %}{{ calc.water.quantity }} người{% endif %}</td>
                <td class="text-right">{{ calc.water.unit_price|vnd }}</td>
                <td class="text-right">{{ calc.water.water_before_tax|vnd }}</td>
                <td class="text-right">{{ (calc.water.vat + calc.water.env_fee)|vnd }}</td>
                <td class="text-right font-bold" style="color: #2b6cb0;">{{ calc.water.total_rounded|vnd }} đ</td>
            </tr>
        </tbody>
    </table>

    <!-- TỔNG CỘNG -->
    <div class="total-box">
        TỔNG SỐ TIỀN PHẢI THANH TOÁN: {{ invoice.invoice_total_final|vnd }} VNĐ
    </div>

    <!-- CHỮ KÝ -->
    <table class="signature-table">
        <tr>
            <td width="50%">
                <strong>NGƯỜI THUÊ PHÒNG</strong><br>
                <span style="font-size: 10px; color: #718096;">(Ký và ghi rõ họ tên)</span>
                <div class="signature-space"></div>
            </td>
            <td width="50%">
                <strong>ĐẠI DIỆN CHỦ CƠ SỞ</strong><br>
                <span style="font-size: 10px; color: #718096;">(Ký và ghi rõ họ tên)</span>
                <div class="signature-space"></div>
            </td>
        </tr>
    </table>
</body>
</html>