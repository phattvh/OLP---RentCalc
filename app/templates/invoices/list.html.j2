{% extends "base.html.j2" %}
{% block title %}Danh sách hóa đơn - RentCalc{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex justify-between items-center border-b pb-5 border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Danh sách hóa đơn tiền phòng</h1>
        </div>
    </div>

    <div class="bg-white shadow rounded-lg border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 whitespace-nowrap">Mã / Kỳ tháng</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 whitespace-nowrap">Phòng</th>
                        <th class="px-6 py-3 text-right font-medium text-gray-500 whitespace-nowrap">Tiền điện (VNĐ)</th>
                        <th class="px-6 py-3 text-right font-medium text-gray-500 whitespace-nowrap">Tiền nước (VNĐ)</th>
                        <th class="px-6 py-3 text-right font-bold text-gray-900 whitespace-nowrap">Tổng quy định (VNĐ)</th>
                        <th class="px-6 py-3 text-right font-medium text-gray-500 whitespace-nowrap">Thực thu</th>
                        <th class="px-6 py-3 text-center font-medium text-gray-500 whitespace-nowrap">Trạng thái</th>
                        <th class="px-6 py-3 text-right font-medium text-gray-500 whitespace-nowrap">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for inv in invoices %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-mono font-medium text-indigo-600 whitespace-nowrap">#{{ inv.id }} - {{ inv.month }}</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 whitespace-nowrap">{{ inv.room.name }}</td>
                        <td class="px-6 py-4 text-right font-mono whitespace-nowrap">{{ inv.electricity_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-right font-mono whitespace-nowrap">{{ inv.water_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-right font-mono font-bold text-indigo-700 whitespace-nowrap">{{ inv.invoice_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-right font-mono whitespace-nowrap">
                            {% if inv.actual_collected %}
                                {{ inv.actual_collected|vnd }} đ
                            {% else %}
                                <span class="text-gray-400">Chưa nhập</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-center whitespace-nowrap">
                            {% if inv.difference is not none %}
                                {% if inv.difference > 0 %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-red-100 text-red-800">Thu vượt +{{ inv.difference|vnd }} đ</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold whitespace-nowrap bg-green-100 text-green-800">Đúng luật</span>
                                {% endif %}
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs whitespace-nowrap bg-gray-100 text-gray-600">Chưa đối chiếu</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="action-btn-group">
                                <a href="/invoices/{{ inv.id }}" class="mini-btn mini-btn-primary">
                                    Chi tiết
                                </a>
                                <a href="/invoices/{{ inv.id }}/pdf" target="_blank" class="mini-btn mini-btn-secondary">
                                    📄 PDF
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-gray-400">Chưa có hóa đơn nào được phát hành.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}