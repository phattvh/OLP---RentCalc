{% extends "base.html.j2" %}

{% block title %}Tổng quan - RentCalc{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="sm:flex sm:items-center sm:justify-between border-b pb-5 border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Bảng điều khiển tổng quan</h1>
            <p class="mt-1 text-sm text-gray-500">Giám sát và minh bạch hóa chi phí điện nước phòng trọ theo quy chuẩn nhà nước.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex space-x-3">
            <a href="/properties/new" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition">
                + Thêm cơ sở
            </a>
            <a href="/admin/configs/new" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition">
                + Cập nhật biểu giá
            </a>
        </div>
    </div>

    <!-- Thẻ thống kê nhanh -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-100 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-indigo-50 text-indigo-600 rounded-md p-3 text-2xl">🏢</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Tổng cơ sở cho thuê</dt>
                        <dd class="text-3xl font-semibold text-gray-900">{{ total_properties }}</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-100 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-blue-50 text-blue-600 rounded-md p-3 text-2xl">🚪</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Tổng số phòng trọ</dt>
                        <dd class="text-3xl font-semibold text-gray-900">{{ total_rooms }}</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="bg-white overflow-hidden shadow rounded-lg border border-gray-100 p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-emerald-50 text-emerald-600 rounded-md p-3 text-2xl">📜</div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Biểu giá đang áp dụng</dt>
                        <dd class="text-base font-semibold text-gray-900 truncate">
                            {% if active_config %}
                                {{ active_config.name }}
                            {% else %}
                                <span class="text-red-500">Chưa kích hoạt</span>
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách cơ sở nhanh -->
    <div class="bg-white shadow rounded-lg border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h2 class="text-lg font-bold text-gray-900">Danh sách các cơ sở</h2>
            <a href="/properties" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">Xem tất cả &rarr;</a>
        </div>
        <div class="divide-y divide-gray-200">
            {% if properties %}
                {% for prop in properties %}
                <div class="p-6 flex items-center justify-between hover:bg-gray-50 transition">
                    <div>
                        <a href="/properties/{{ prop.id }}" class="text-base font-semibold text-indigo-600 hover:underline">{{ prop.name }}</a>
                        <p class="text-sm text-gray-500 mt-0.5">{{ prop.address or "Chưa có địa chỉ" }}</p>
                    </div>
                    <div class="flex items-center space-x-4 text-sm text-gray-500">
                        <span>{{ prop.rooms|length }} phòng</span>
                        <a href="/properties/{{ prop.id }}" class="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 transition">Quản lý</a>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="p-8 text-center text-gray-500">
                    Chưa có cơ sở nào. Hãy bấm <a href="/properties/new" class="text-indigo-600 font-semibold underline">Thêm cơ sở mới</a> để bắt đầu!
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}