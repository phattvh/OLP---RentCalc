{% extends "base.html.j2" %}

{% block title %}Bảng điều khiển tổng quan - RentCalc{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Tiêu đề và nút tác vụ nhanh -->
    <div class="sm:flex sm:items-center sm:justify-between border-b pb-5 border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Bảng điều khiển tổng quan</h1>
            <p class="mt-1 text-sm text-gray-500">Giám sát và minh bạch hóa chi phí điện nước phòng trọ theo quy chuẩn Nghị định 133/2026/NĐ-CP.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2.5 items-center">
            <a href="/properties/new" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition">
                + Thêm cơ sở
            </a>
            <a href="/admin/configs/new" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50 transition">
                + Cập nhật biểu giá
            </a>
        </div>
    </div>

    <!-- 4 THẺ THỐNG KÊ CHÍNH -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Cơ sở -->
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-xl border border-gray-100 p-5 transition">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-indigo-50 text-indigo-600 rounded-xl p-3 text-2xl">🏢</div>
                <div class="ml-4 flex-1">
                    <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Cơ sở cho thuê</dt>
                    <dd class="mt-0.5 text-2xl font-black text-gray-900">{{ total_properties }}</dd>
                </div>
            </div>
        </div>

        <!-- Phòng trọ -->
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-xl border border-gray-100 p-5 transition">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-blue-50 text-blue-600 rounded-xl p-3 text-2xl">🚪</div>
                <div class="ml-4 flex-1">
                    <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Phòng đang quản lý</dt>
                    <dd class="mt-0.5 text-2xl font-black text-gray-900">{{ total_rooms }}</dd>
                </div>
            </div>
        </div>

        <!-- Tổng hóa đơn -->
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-xl border border-gray-100 p-5 transition">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-emerald-50 text-emerald-600 rounded-xl p-3 text-2xl">🧾</div>
                <div class="ml-4 flex-1">
                    <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Hóa đơn phát hành</dt>
                    <dd class="mt-0.5 text-2xl font-black text-gray-900">{{ total_invoices }}</dd>
                </div>
            </div>
        </div>

        <!-- Cảnh báo thu vượt -->
        <div class="bg-white overflow-hidden shadow-sm hover:shadow rounded-xl border {% if overcharge_count > 0 %}border-red-300 bg-red-50/40{% else %}border-gray-100{% endif %} p-5 transition">
            <div class="flex items-center">
                <div class="flex-shrink-0 {% if overcharge_count > 0 %}bg-red-100 text-red-600{% else %}bg-green-100 text-green-600{% endif %} rounded-xl p-3 text-2xl">
                    {% if overcharge_count > 0 %}⚠️{% else %}✅{% endif %}
                </div>
                <div class="ml-4 flex-1">
                    <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Cảnh báo thu vượt</dt>
                    <dd class="mt-0.5 text-2xl font-black {% if overcharge_count > 0 %}text-red-600{% else %}text-green-700{% endif %}">
                        {{ overcharge_count }}
                    </dd>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER CẢNH BÁO NẾU CÓ HÓA ĐƠN THU VƯỢT QUY ĐỊNH -->
    {% if overcharge_count > 0 %}
    <div class="bg-red-50 border-l-4 border-red-500 p-5 rounded-r-xl shadow-sm space-y-3">
        <div class="flex items-start">
            <div class="flex-shrink-0 text-red-600 font-bold text-2xl mr-3 leading-none">⚠️</div>
            <div class="text-xs text-red-900 space-y-1.5 flex-1">
                <p class="font-bold text-sm text-red-800">CẢNH BÁO PHÁP LÝ: PHÁT HIỆN {{ overcharge_count }} HÓA ĐƠN THU TIỀN CAO HƠN QUY ĐỊNH NHÀ NƯỚC!</p>
                <p class="leading-relaxed">Theo <strong>Điều 31 Nghị định số 133/2026/NĐ-CP</strong>, hành vi thu tiền điện nước cao hơn quy chuẩn sẽ bị xử phạt từ <strong>20.000.000 đ đến 30.000.000 đ</strong>.</p>
                <div class="mt-2 pt-2.5 border-t border-red-200">
                    <span class="font-bold text-red-950">Các hóa đơn vi phạm cần xử lý ngay:</span>
                    <ul class="mt-1.5 space-y-1 font-mono">
                        {% for bad_inv in overcharge_invoices %}
                        <li>
                            <a href="/invoices/{{ bad_inv.id }}" class="inline-flex items-center text-red-700 hover:text-red-950 font-bold underline hover:no-underline">
                                &bull; Hóa đơn #{{ bad_inv.id }} ({% if bad_inv.room.name.startswith('Phòng') %}{{ bad_inv.room.name }}{% else %}Phòng {{ bad_inv.room.name }}{% endif %} - Tháng {{ bad_inv.month }}): Thu vượt +{{ bad_inv.difference|vnd }} đ &rarr;
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- BẢNG 5 HÓA ĐƠN GẦN NHẤT -->
    <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/70">
            <h2 class="text-base font-bold text-gray-800">5 hóa đơn phát hành gần nhất</h2>
            <a href="/invoices" class="text-xs font-semibold text-indigo-600 hover:text-indigo-900">Xem tất cả hóa đơn &rarr;</a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-600">Mã / Kỳ</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-600">Phòng</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-600">Tiền điện</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-600">Tiền nước</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-600">Tổng quy định</th>
                        <th class="px-6 py-3 text-center font-semibold text-gray-600">Đối chiếu thực thu</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-600">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {% for inv in recent_invoices %}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-mono font-medium text-indigo-600 whitespace-nowrap">#{{ inv.id }} ({{ inv.month }})</td>
                        <td class="px-6 py-4 font-semibold text-gray-900 whitespace-nowrap">{{ inv.room.name }}</td>
                        <td class="px-6 py-4 text-right font-mono whitespace-nowrap">{{ inv.electricity_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-right font-mono whitespace-nowrap">{{ inv.water_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-right font-mono font-bold text-indigo-700 whitespace-nowrap">{{ inv.invoice_total_final|vnd }} đ</td>
                        <td class="px-6 py-4 text-center whitespace-nowrap">
                            {% if inv.difference is not none %}
                                {% if inv.difference > 0 %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800">Thu vượt +{{ inv.difference|vnd }} đ</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800">Đúng quy chuẩn</span>
                                {% endif %}
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-gray-100 text-gray-500">Chưa đối chiếu</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4 text-right whitespace-nowrap">
                            <div class="inline-flex items-center space-x-1.5">
                                <a href="/invoices/{{ inv.id }}" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition">
                                    Chi tiết
                                </a>
                                <a href="/invoices/{{ inv.id }}/pdf" class="px-2.5 py-1 text-xs font-semibold rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 transition">
                                    📄 PDF
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-400">Chưa có hóa đơn nào được phát hành.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}