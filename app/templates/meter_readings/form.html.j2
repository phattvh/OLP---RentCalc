{% extends "base.html.j2" %}
{% block title %}Ghi chỉ số công tơ - {{ room.name }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto bg-white p-8 rounded-lg shadow border border-gray-100">
    <div class="mb-6">
        <a href="/rooms/{{ room.id }}" class="inline-flex items-center px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-100 shadow-sm transition mb-3">&larr; Quay lại {{ room.name }}</a>
        <h1 class="text-2xl font-bold text-gray-900">Ghi chỉ số công tơ</h1>
    </div>

    <form action="/rooms/{{ room.id }}/readings" method="POST" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700">Kỳ tháng (YYYY-MM) <span class="text-red-500">*</span></label>
            <input type="month" name="month" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Loại dịch vụ <span class="text-red-500">*</span></label>
            <select name="meter_type" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
                <option value="electricity">⚡ Điện sinh hoạt</option>
                <option value="water">💧 Nước sinh hoạt</option>
            </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Chỉ số đầu kỳ <span class="text-red-500">*</span></label>
                <input type="text" name="start_reading" required placeholder="Ví dụ: 1250" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-mono">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Chỉ số cuối kỳ <span class="text-red-500">*</span></label>
                <input type="text" name="end_reading" required placeholder="Ví dụ: 1420" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-mono">
            </div>
        </div>

        <!-- Cảnh báo công tơ quay vòng (Rollover Warning) -->
        <div id="rollover-warning" class="hidden bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-md">
            <div class="flex items-start">
                <span class="text-amber-600 text-lg mr-2">⚠️</span>
                <div class="text-xs text-amber-800 space-y-1">
                    <p class="font-bold text-amber-900">CÔNG TƠ ĐÃ QUAY VÒNG (ROLLOVER):</p>
                    <p>Chỉ số cuối kỳ nhỏ hơn chỉ số đầu kỳ. Hệ thống sẽ áp dụng quy tắc cơ học: <code class="bg-amber-100 px-1 py-0.5 rounded font-mono font-bold">(Giá trị max + 1) − Đầu kỳ + Cuối kỳ</code>.</p>
                    <p>Sản lượng dự kiến: <strong id="preview-consumption" class="font-mono text-sm text-amber-900 font-black">0</strong></p>
                </div>
            </div>
        </div>

        <p class="text-xs text-gray-500">Hệ thống hỗ trợ tự động xử lý hiện tượng quay vòng số công tơ cơ khí (Rollover qua 99999).</p>

        <div>
            <label class="block text-sm font-medium text-gray-700">Ghi chú</label>
            <input type="text" name="notes" placeholder="Ghi chú thêm..." class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
        </div>

        <div class="pt-4 flex justify-end space-x-3">
            <a href="/rooms/{{ room.id }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Hủy</a>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 shadow-sm">Lưu chỉ số</button>
        </div>
    </form>
</div>

<script>
    const startInput = document.querySelector('input[name="start_reading"]');
    const endInput = document.querySelector('input[name="end_reading"]');
    const warningBox = document.getElementById('rollover-warning');
    const previewSpan = document.getElementById('preview-consumption');

    function checkRollover() {
        const start = parseFloat(startInput.value);
        const end = parseFloat(endInput.value);
        if (!isNaN(start) && !isNaN(end)) {
            if (end < start) {
                // Giả định công tơ 5 số thông dụng (max 99999)
                const consumption = (99999 + 1) - start + end;
                previewSpan.textContent = consumption.toLocaleString('vi-VN');
                warningBox.classList.remove('hidden');
            } else {
                warningBox.classList.add('hidden');
            }
        } else {
            warningBox.classList.add('hidden');
        }
    }

    startInput.addEventListener('input', checkRollover);
    endInput.addEventListener('input', checkRollover);
</script>
{% endblock %}