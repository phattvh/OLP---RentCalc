{% extends "base.html.j2" %}
{% block title %}Tạo cấu hình biểu giá mới - RentCalc{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto bg-white p-8 rounded-lg shadow border border-gray-200">
    <div class="mb-6 border-b pb-4">
        <a href="/admin/configs" class="inline-flex items-center px-3 py-1.5 bg-gray-50 border border-gray-300 rounded-lg text-xs font-semibold text-gray-700 hover:bg-gray-100 shadow-sm transition mb-3">&larr; Quay lại danh sách cấu hình</a>
        <h1 class="text-2xl font-bold text-gray-900">Cấu hình biểu giá mới</h1>
        <p class="text-xs text-gray-500">Khi lưu, biểu giá mới này sẽ tự động được kích hoạt áp dụng cho toàn bộ các hóa đơn tính từ thời điểm này.</p>
    </div>

    <form action="/admin/configs" method="POST" class="space-y-6">
        <!-- Thông tin chung -->
        <div class="space-y-4">
            <h3 class="text-sm font-bold text-indigo-700 uppercase tracking-wide">1. Thông tin chung & Căn cứ pháp lý</h3>
            <div>
                <label class="block text-xs font-semibold text-gray-700">Tên cấu hình <span class="text-red-500">*</span></label>
                <input type="text" name="name" required value="Biểu giá chính thức 2026" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700">Căn cứ văn bản pháp luật</label>
                <input type="text" name="description" value="Căn cứ QĐ 1279/QĐ-BCT, TT 60/2025/TT-BCT & NQ 204/2025/QH15" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm">
            </div>
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Thuế VAT điện (8% = 0.08)</label>
                    <input type="text" name="vat_rate" value="0.08" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Số người / 1 định mức</label>
                    <input type="text" name="people_per_quota" value="4" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Bậc áp khi không kê khai</label>
                    <input type="number" name="fallback_tier_number" value="3" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
            </div>
        </div>

        <!-- Bảng bậc thang điện tùy biến số lượng bậc -->
        <div class="space-y-4 pt-4 border-t border-gray-200">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                    <h3 class="text-sm font-bold text-amber-600 uppercase tracking-wide">2. Bảng bậc thang điện sinh hoạt (Tùy biến số lượng bậc, ngưỡng & đơn giá)</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Linh hoạt cấu hình: 5 bậc (dự thảo mới), 6 bậc (QĐ 1279 hiện hành), hoặc biểu giá riêng. Bậc cuối cùng luôn tự động áp dụng vô hạn sản lượng.</p>
                </div>
                <button type="button" onclick="addTier()" class="self-start sm:self-auto inline-flex items-center px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-semibold rounded border border-amber-300 shadow-sm transition">
                    + Thêm bậc thang
                </button>
            </div>

            <div id="tiers-container" class="space-y-3">
                <!-- Javascript sẽ nạp động các bậc thang ở đây -->
            </div>
        </div>

        <!-- Tiền nước -->
        <div class="space-y-4 pt-4 border-t border-gray-200">
            <h3 class="text-sm font-bold text-blue-600 uppercase tracking-wide">3. Đơn giá & Thuế phí nước sinh hoạt</h3>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Giá nước theo khối (VNĐ/m³):</label>
                    <input type="text" name="water_volume_price" value="8500" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Giá nước khoán (VNĐ/người/tháng):</label>
                    <input type="text" name="water_person_price" value="80000" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Thuế VAT nước (5% = 0.05):</label>
                    <input type="text" name="water_vat" value="0.05" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700">Phí BVMT nước thải (10% = 0.10):</label>
                    <input type="text" name="water_env" value="0.10" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                </div>
            </div>
        </div>

        <!-- Cấu hình công tơ -->
        <div class="space-y-4 pt-4 border-t border-gray-200">
            <h3 class="text-sm font-bold text-emerald-600 uppercase tracking-wide">4. Cấu hình giới hạn công tơ (Xử lý quay vòng - Rollover)</h3>
            <div>
                <label class="block text-xs font-semibold text-gray-700">Chỉ số cực đại của công tơ (Max Value):</label>
                <input type="text" name="meter_max" value="99999" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded text-sm font-mono">
                <p class="text-xs text-gray-500 mt-1">Mặc định: <strong>99999</strong> cho công tơ 5 chữ số. Hỗ trợ thay đổi thành 999999 (6 số) hoặc số tùy biến theo chủng loại đồng hồ.</p>
            </div>
        </div>

        <div class="pt-4 flex justify-end space-x-3 border-t border-gray-200">
            <a href="/admin/configs" class="px-4 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 hover:bg-gray-50">Hủy</a>
            <button type="submit" class="px-5 py-2 bg-indigo-600 text-white text-sm font-semibold rounded hover:bg-indigo-700 shadow-sm">
                Lưu & Kích hoạt biểu giá
            </button>
        </div>
    </form>
</div>

<script>
let tiers = [
    { qty: "50", price: "1984" },
    { qty: "50", price: "2050" },
    { qty: "100", price: "2380" },
    { qty: "100", price: "2998" },
    { qty: "100", price: "3350" },
    { qty: "", price: "3460" }
];

function renderTiers() {
    const container = document.getElementById("tiers-container");
    if (!container) return;
    container.innerHTML = "";

    tiers.forEach((t, index) => {
        const isLast = index === tiers.length - 1;
        const tierNum = index + 1;
        const div = document.createElement("div");
        div.className = "bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-2";

        let qtyInput = isLast
            ? `<input type="hidden" name="tier_qty" value="">
               <input type="text" disabled value="Không giới hạn (Vô hạn)" class="mt-1 block w-full px-3 py-1.5 bg-gray-200 text-gray-600 border border-gray-300 rounded text-sm italic">`
            : `<input type="text" name="tier_qty" value="${t.qty}" required oninput="tiers[${index}].qty = this.value" class="mt-1 block w-full px-3 py-1.5 border border-gray-300 rounded text-sm font-mono">`;

        let deleteBtn = tiers.length > 1
            ? `<button type="button" onclick="removeTier(${index})" class="text-xs text-red-600 hover:text-red-800 font-medium px-2 py-0.5 rounded hover:bg-red-50 transition">Xóa bậc này</button>`
            : '';

        div.innerHTML = `
            <div class="flex items-center justify-between pb-1.5 border-b border-gray-200">
                <span class="text-xs font-bold text-gray-800">
                    Bậc ${tierNum} ${isLast ? '<span class="text-amber-600 font-normal italic ml-1">(Bậc cao nhất - Vô hạn)</span>' : ''}
                </span>
                <input type="hidden" name="tier_name" value="Bậc ${tierNum}">
                ${deleteBtn}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
                <div>
                    <label class="block text-xs font-medium text-gray-700">Ngưỡng định mức cơ sở (kWh):</label>
                    ${qtyInput}
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-700">Đơn giá (VNĐ/kWh):</label>
                    <input type="text" name="tier_price" value="${t.price}" required oninput="tiers[${index}].price = this.value" class="mt-1 block w-full px-3 py-1.5 border border-gray-300 rounded text-sm font-mono">
                </div>
            </div>
        `;
        container.appendChild(div);
    });
}

function addTier() {
    if (tiers.length > 0) {
        if (!tiers[tiers.length - 1].qty) {
            tiers[tiers.length - 1].qty = "100";
        }
    }
    const lastPrice = tiers.length > 0 ? (parseInt(tiers[tiers.length - 1].price) || 3000) + 100 : 2000;
    tiers.push({ qty: "", price: String(lastPrice) });
    renderTiers();
}

function removeTier(index) {
    if (tiers.length <= 1) return;
    tiers.splice(index, 1);
    tiers[tiers.length - 1].qty = "";
    renderTiers();
}

document.addEventListener("DOMContentLoaded", renderTiers);
</script>
{% endblock %}