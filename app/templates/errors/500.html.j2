{% extends "base.html.j2" %}

{% block title %}500 - Lỗi máy chủ nội bộ - RentCalc{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto my-12 text-center bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 text-red-600 text-4xl mb-4" role="img" aria-label="Biểu tượng cảnh báo lỗi máy chủ">
        ⚠️
    </div>
    <h1 class="text-4xl font-black text-red-600 tracking-tight">500</h1>
    <h2 class="mt-2 text-xl font-bold text-gray-800">Đã xảy ra sự cố phía máy chủ</h2>
    <p class="mt-3 text-sm text-gray-500 leading-relaxed">
        Hệ thống gặp lỗi trong quá trình xử lý yêu cầu. Vui lòng thử lại sau giây lát hoặc liên hệ quản trị viên.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-sm text-sm transition" aria-label="Về trang chủ RentCalc">
            &larr; Về trang chủ
        </a>
        <a href="javascript:location.reload()" class="px-5 py-2.5 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-semibold rounded-lg shadow-sm text-sm transition" aria-label="Thử tải lại trang">
            Tải lại trang
        </a>
    </div>
</div>
{% endblock %}
