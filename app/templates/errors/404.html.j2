{% extends "base.html.j2" %}

{% block title %}404 - Không tìm thấy trang - RentCalc{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto my-12 text-center bg-white p-8 rounded-2xl shadow-sm border border-gray-200">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-indigo-50 text-indigo-600 text-4xl mb-4" role="img" aria-label="Biểu tượng tìm kiếm không thấy">
        🔍
    </div>
    <h1 class="text-4xl font-black text-gray-900 tracking-tight">404</h1>
