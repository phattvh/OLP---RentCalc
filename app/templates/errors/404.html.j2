    <p class="mt-3 text-sm text-gray-500 leading-relaxed">
        Đường dẫn bạn vừa truy cập không tồn tại, đã bị di chuyển hoặc mã liên kết không hợp lệ.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-sm text-sm transition" aria-label="Về trang chủ RentCalc">
            &larr; Về trang chủ
        </a>
        <a href="javascript:history.back()" class="px-5 py-2.5 border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-semibold rounded-lg shadow-sm text-sm transition" aria-label="Quay lại trang trước">
            Quay lại trang trước
        </a>
    </div>
</div>
{% endblock %}
