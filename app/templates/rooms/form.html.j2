{% extends "base.html.j2" %}
{% block title %}Thêm phòng mới - {{ property.name }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow border border-gray-100">
    <div class="mb-6">
        <a href="/properties/{{ property.id }}" class="text-xs text-gray-500 hover:underline">&larr; Quay lại {{ property.name }}</a>
        <h1 class="text-2xl font-bold text-gray-900 mt-1">Thêm phòng mới</h1>
    </div>

    <form action="/properties/{{ property.id }}/rooms" method="POST" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700">Tên phòng <span class="text-red-500">*</span></label>
            <input type="text" name="name" required placeholder="Ví dụ: Phòng 101" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Số người ở <span class="text-red-500">*</span></label>
                <input type="number" name="people_count" value="1" min="0" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
                <p class="text-xs text-gray-500 mt-1">Dùng để tính định mức điện (4 người = 1 định mức).</p>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Phương thức tính tiền nước</label>
                <select name="water_billing_mode" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm">
                    <option value="volume">Theo khối đồng hồ (m³)</option>
                    <option value="per_person">Khoán theo đầu người</option>
                </select>
            </div>
        </div>

        <div class="pt-2">
            <label class="flex items-center space-x-2">
                <input type="checkbox" name="is_declared" value="true" checked class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                <span class="text-sm font-medium text-gray-800">Đã đăng ký tạm trú / kê khai số người với điện lực</span>
            </label>
            <p class="text-xs text-gray-500 ml-6 mt-0.5">Nếu không tích chọn, hệ thống sẽ áp dụng biểu giá Bậc 3 theo đúng Thông tư 60/2025/TT-BCT.</p>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Ghi chú</label>
            <textarea name="notes" rows="2" placeholder="Ghi chú người đại diện thuê..." class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm"></textarea>
        </div>

        <div class="pt-4 flex justify-end space-x-3">
            <a href="/properties/{{ property.id }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Hủy</a>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 shadow-sm">Lưu phòng</button>
        </div>
    </form>
</div>
{% endblock %}