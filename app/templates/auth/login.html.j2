{% extends "base.html.j2" %}
{% block title %}Đăng nhập - RentCalc{% endblock %}

{% block content %}
<div class="max-w-md mx-auto mt-8 bg-white p-8 rounded-xl shadow-md border border-gray-100">
    <div class="text-center mb-6">
        <span class="text-4xl">🔐</span>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">Đăng nhập hệ thống</h1>
        <p class="text-xs text-gray-500 mt-1">Hệ thống phân quyền cho Chủ cơ sở và Người thuê</p>
    </div>

    {% if error %}
    <div class="mb-4 p-3 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded">
        {{ error }}
    </div>
    {% endif %}

    <form method="POST" action="/login" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tên đăng nhập</label>
            <input type="text" name="username" required autofocus placeholder="Ví dụ: owner hoặc tenant101"
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
            <input type="password" name="password" required placeholder="Nhập mật khẩu"
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm">
        </div>

        <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-md shadow transition text-sm">
            Đăng nhập ngay
        </button>
    </form>

    <div class="mt-6 p-3 bg-gray-50 rounded-lg text-xs text-gray-600 border border-gray-200">
        <p class="font-bold text-gray-700 mb-1">Tài khoản demo sẵn có:</p>
        <ul class="space-y-1 font-mono">
            <li>👑 <strong>Chủ nhà:</strong> owner / owner123</li>
            <li>🏠 <strong>Người thuê:</strong> tenant101 / tenant123</li>
        </ul>
    </div>
</div>
{% endblock %}